{
  ignore_readline_reachable
  Memcheck:Leak
  match-leak-kinds: reachable
  ...
  obj:*/libreadline*.so*
}
{
  ignore_readline_history_reachable
  Memcheck:Leak
  match-leak-kinds: reachable
  ...
  fun:add_history
  obj:*/libreadline*.so*
}

{
	ignore_readline_leaks
	Memcheck:Leak
	...
	fun:readline
}
{
	ignore_rl_history_leaks
	Memcheck:Leak
	...
	fun:add_history
}
